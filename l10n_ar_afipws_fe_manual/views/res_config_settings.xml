<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ar_afipws_fe_manual</field>
        <field name="model">res.config.settings</field>
        <field eval="41" name="priority" />
        <field name="inherit_id" ref="l10n_ar_afipws.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <field name="afip_ws_env_type" position="after">
                <label for="l10n_ar_afipws_manual_auth" />
                <div class="o_row">
                    <field name="l10n_ar_afipws_manual_auth" />
                    <span>
                        Requerir click en "Enviar ARCA" para autorizar
                        (si está desactivado, se autoriza automáticamente al confirmar la factura)
                    </span>
                </div>
                <label for="l10n_ar_pos_invoice_default" />
                <div class="o_row">
                    <field name="l10n_ar_pos_invoice_default" />
                    <span>
                        Botón "Factura" marcado por defecto en la pantalla de pago del POS
                        (si está desactivado, el cajero lo marca solo cuando el cliente pide factura)
                    </span>
                </div>
                <label for="l10n_ar_pos_invoice_download" />
                <div class="o_row">
                    <field name="l10n_ar_pos_invoice_download" />
                    <span>
                        Descargar el PDF de la factura al validar el pago en el POS
                        (si está desactivado, la factura se genera igual pero no se descarga)
                    </span>
                </div>
            </field>
        </field>
    </record>
</odoo>
