<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_alert_own_checks" model="ir.cron">
        <field name="name">LATAM Cheques: Alertas de vencimiento (cheques propios)</field>
        <field name="model_id" ref="l10n_latam_check.model_l10n_latam_check"/>
        <field name="state">code</field>
        <field name="code">model._cron_alert_own_checks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_alert_third_party_checks" model="ir.cron">
        <field name="name">LATAM Cheques: Alertas de vencimiento (cheques de terceros)</field>
        <field name="model_id" ref="l10n_latam_check.model_l10n_latam_check"/>
        <field name="state">code</field>
        <field name="code">model._cron_alert_third_party_checks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
