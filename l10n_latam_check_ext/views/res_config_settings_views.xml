<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_l10n_latam_check_ext" model="ir.ui.view">
        <field name="name">res.config.settings.l10n_latam_check_ext</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="print_vendor_checks_setting_container" position="after">

                <block title="Cheques Propios — Valores por defecto"
                       name="latam_own_check_defaults_container"
                       groups="account.group_account_manager">
                    <setting string="Emisión de cheques propios"
                             help="Valores que se completan solos al emitir un cheque propio desde los pagos de compras. El banco es uno de los definidos en las cuentas bancarias de la compañía; el CUIT emisor es el de la compañía.">
                        <div class="content-group">
                            <field name="l10n_latam_company_partner_id" invisible="1"/>
                            <div class="row">
                                <label for="l10n_latam_default_check_bank_id" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_default_check_bank_id" class="col-lg-8"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row mt4">
                                <label for="l10n_latam_default_check_type" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_default_check_type" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>

                <block title="Alertas de Vencimiento — Cheques Propios"
                       name="latam_own_check_alert_container"
                       groups="account.group_account_manager">
                    <setting string="Días de aviso"
                             help="Cantidad de días antes del vencimiento para enviar la alerta. 0 = desactivado.">
                        <div class="content-group">
                            <div class="row">
                                <label for="l10n_latam_own_check_alert_days" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_own_check_alert_days" class="col-lg-8"/>
                            </div>
                            <div class="row mt4">
                                <label for="l10n_latam_own_check_alert_user_ids" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_own_check_alert_user_ids"
                                       widget="many2many_tags"
                                       class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>

                <block title="Alertas de Vencimiento — Cheques de Terceros"
                       name="latam_third_check_alert_container"
                       groups="account.group_account_manager">
                    <setting string="Días de aviso"
                             help="Cantidad de días antes del vencimiento para enviar la alerta. 0 = desactivado.">
                        <div class="content-group">
                            <div class="row">
                                <label for="l10n_latam_third_check_alert_days" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_third_check_alert_days" class="col-lg-8"/>
                            </div>
                            <div class="row mt4">
                                <label for="l10n_latam_third_check_alert_user_ids" class="col-lg-4 o_light_label"/>
                                <field name="l10n_latam_third_check_alert_user_ids"
                                       widget="many2many_tags"
                                       class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>

            </block>
        </field>
    </record>

</odoo>
