<odoo>

    <!-- "Cheques de terceros" list: por defecto solo muestra cheques que ya
         tienen su account.payment (payment_method_code/payment_id.state
         dependen de payment_id). Con pos.payment creando el l10n_latam.check
         instantáneo (sin payment_id todavía, ver models/pos_payment.py), esos
         cheques recién creados quedaban invisibles acá hasta el cierre de
         sesión/facturación. Se amplía el dominio para incluirlos también. -->
    <record id="l10n_latam_check.action_third_party_check" model="ir.actions.act_window">
        <field name="domain">['|', '&amp;', ('payment_method_code', '=', 'new_third_party_checks'), ('payment_id.state', '!=', 'draft'), ('payment_id', '=', False)]</field>
    </record>

    <!-- Default "On hand" filter on that same list: originally required a
         real account.payment (`current_journal_id` is related off it), so it
         never matched our instantly-created, not-yet-accounted checks either.
         Redefined against `issue_state` (only truly 'handed' once reconciled
         via an outstanding_line_id, see l10n_latam_check core) instead. -->
    <record id="l10n_latam_check_ext_view_third_party_checks_search" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.third_party_checks.search</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_third_party_checks_search"/>
        <field name="arch" type="xml">
            <filter name="checks_on_hand" position="attributes">
                <attribute name="domain">[('issue_state', '!=', 'handed')]</attribute>
            </filter>
        </field>
    </record>

    <!-- Search view: filtro "Por vencer" (usa alert_days de la compañía) -->
    <record id="l10n_latam_check_ext_view_search" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.search</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="checks_debited" position="after">
                <separator/>
                <filter name="expiring_soon" string="Por vencer"
                        domain="[('is_expiring_soon', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Form view: add check_type + issue_date in first group -->
    <record id="l10n_latam_check_ext_view_form" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.form</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="check_type"/>
                <field name="issue_date"/>
            </field>
        </field>
    </record>

    <!-- Own checks list view: add check_type + issue_date columns -->
    <record id="l10n_latam_check_ext_view_own_check_tree" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.own_check.list</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_own_check_tree"/>
        <field name="arch" type="xml">
            <field name="payment_date" position="before">
                <field name="check_type" optional="show"/>
                <field name="issue_date" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Payment form — new_checks inline list: add check_type + issue_date -->
    <record id="l10n_latam_check_ext_view_payment_form" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <list name="new_checks">
                <field name="name" position="after">
                    <field name="check_type"/>
                    <field name="issue_date"/>
                </field>
            </list>
            <list name="existing_checks">
                <field name="name" position="after">
                    <field name="check_type" optional="hide"/>
                    <field name="issue_date" optional="hide"/>
                </field>
            </list>
        </field>
    </record>


    <!-- Payment Register wizard (botón "Pagar" de facturas): new_checks + existing_checks -->
    <record id="l10n_latam_check_ext_view_payment_register" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- new_checks list has no name attribute in the wizard, use xpath -->
            <xpath expr="//field[@name='l10n_latam_new_check_ids']//field[@name='name']" position="after">
                <field name="check_type"/>
                <field name="issue_date"/>
            </xpath>
            <list name="existing_checks">
                <field name="name" position="after">
                    <field name="check_type" optional="hide"/>
                    <field name="issue_date" optional="hide"/>
                </field>
            </list>
        </field>
    </record>

</odoo>
