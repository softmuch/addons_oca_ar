<odoo>

    <!-- "Cheques de terceros" list: por defecto solo muestra cheques que ya
         tienen su account.payment (payment_method_code/payment_id.state
         dependen de payment_id). Con pos.payment creando el l10n_latam.check
         instantáneo (sin payment_id todavía, ver models/pos_payment.py), esos
         cheques recién creados quedaban invisibles acá hasta el cierre de
         sesión/facturación. Se amplía el dominio para incluirlos también. -->
    <record id="l10n_latam_check.action_third_party_check" model="ir.actions.act_window">
        <field name="domain">[('check_kind', '=', 'third_party'), '|', ('payment_id', '=', False), ('payment_id.state', '!=', 'draft')]</field>
    </record>

    <!-- Default "On hand" filter on that same list: originally required a
         real account.payment (`current_journal_id` is related off it), so it
         never matched our instantly-created, not-yet-accounted checks either.
         Redefined against `check_state` instead: `issue_state` (core) is only
         ever set for own checks posted through core's own flow, so it's empty
         for every check we create. "On hand" = still ours: neither cashed
         ('paid') nor handed over ('transferred'). -->
    <record id="l10n_latam_check_ext_view_third_party_checks_search" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.third_party_checks.search</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_third_party_checks_search"/>
        <field name="arch" type="xml">
            <filter name="checks_on_hand" position="attributes">
                <attribute name="domain">[('check_state', 'not in', ['transferred', 'paid'])]</attribute>
            </filter>
        </field>
    </record>

    <!-- Search view: filtro "Por vencer" (usa alert_days de la compañía) -->
    <record id="l10n_latam_check_ext_view_search" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.search</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="checks_debited" position="after">
                <separator/>
                <filter name="expiring_soon" string="Por vencer"
                        domain="[('is_expiring_soon', '=', True)]"/>
                <separator/>
                <filter name="check_state_collected" string="Cobrado / Pagado" domain="[('check_state', '=', 'paid')]"/>
                <filter name="check_state_not_collected" string="No Cobrado / No Pagado" domain="[('check_state', '=', 'not_paid')]"/>
                <filter name="check_state_transferred" string="Girado" domain="[('check_state', '=', 'transferred')]"/>
                <filter name="check_state_pending" string="Pendientes (no pagados)" domain="[('check_state', 'not in', ['paid'])]"/>
            </filter>
            <filter name="groupby_issue_state" position="after">
                <filter name="groupby_check_state" string="Estado de Cobro (terceros)" domain="[]"
                        context="{'group_by': 'check_state_third'}"/>
                <filter name="groupby_check_state_own" string="Estado de Pago (propios)" domain="[]"
                        context="{'group_by': 'check_state_own'}"/>
            </filter>
        </field>
    </record>

    <!-- Form view: add check_type + issue_date in first group, plus
         check_state (badge, always visible) with mark-as-paid buttons.
         The form is `edit="false"` by design (legal/audit document), so
         check_state changes go through action_mark_paid/_not_paid instead
         of raw field editing. -->
    <record id="l10n_latam_check_ext_view_form" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.form</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="check_type"/>
                <field name="issue_date"/>
                <field name="check_kind" invisible="1"/>
                <field name="check_state_third" widget="badge" invisible="check_kind != 'third_party'"
                       decoration-success="check_state_third == 'paid'"
                       decoration-warning="check_state_third == 'transferred'"
                       decoration-danger="check_state_third == 'not_paid'"/>
                <field name="check_state_own" widget="badge" invisible="check_kind != 'own'"
                       decoration-success="check_state_own == 'paid'"
                       decoration-danger="check_state_own == 'not_paid'"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_edit_check" string="Editar" type="object" class="btn-secondary"
                        groups="account.group_account_invoice"/>
                <field name="check_state" invisible="1"/>
                <button name="action_mark_paid" string="Marcar como Cobrado" type="object" class="btn-secondary"
                        invisible="check_kind != 'third_party' or check_state != 'not_paid'"/>
                <button name="action_mark_not_paid" string="Marcar como No Cobrado" type="object" class="btn-secondary"
                        invisible="check_kind != 'third_party' or check_state != 'paid'"/>
                <button name="action_mark_paid" string="Marcar como Pagado" type="object" class="btn-secondary"
                        invisible="check_kind != 'own' or check_state != 'not_paid'"/>
                <button name="action_mark_not_paid" string="Marcar como No Pagado" type="object" class="btn-secondary"
                        invisible="check_kind != 'own' or check_state != 'paid'"/>
            </xpath>
        </field>
    </record>

    <!-- "Cheques Propios" of the Facturación app (core's "Own Checks"): same
         domain as the Compras / Punto de venta ones (own checks, whether or
         not they went through core's own accounting flow) and the same
         predefined filter: everything not yet paid. -->
    <record id="l10n_latam_check.action_own_check" model="ir.actions.act_window">
        <field name="domain">[('check_kind', '=', 'own')]</field>
        <field name="context">{'search_default_check_state_pending': 1}</field>
    </record>

    <!-- Core's own check form shows `issue_state` as a statusbar and its
         list as a badge, but it's only ever set for own checks posted
         through core's accounting flow - empty for the ones we create. -->
    <record id="l10n_latam_check_ext_view_form_issue_state" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.form.issue_state</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="issue_state" position="attributes">
                <attribute name="invisible">not issue_state</attribute>
            </field>
        </field>
    </record>

    <!-- Editable twin of the check form (primary view: inherits the read-only
         form with all its extensions). "Editar" opens it, "Bloquear" goes
         back to the read-only one. -->
    <record id="l10n_latam_check_view_form_edit" model="ir.ui.view">
        <field name="name">l10n_latam_check.view.form.edit</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="edit">true</attribute>
            </xpath>
            <button name="action_edit_check" position="replace">
                <button name="action_lock_check" string="Bloquear" type="object" class="btn-primary"/>
            </button>
        </field>
    </record>

    <!-- Own checks list view: add check_type + issue_date + check_state
         columns. Inherited automatically by the third-party checks list too
         (l10n_latam_check.view_account_third_party_check_tree itself
         inherits this same view). -->
    <record id="l10n_latam_check_ext_view_own_check_tree" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.own_check.list</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_own_check_tree"/>
        <field name="arch" type="xml">
            <field name="issue_state" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="payment_date" position="before">
                <field name="check_type" optional="show"/>
                <field name="issue_date" optional="show"/>
                <field name="check_state_own" optional="show" widget="badge"
                       decoration-success="check_state_own == 'paid'"
                       decoration-danger="check_state_own == 'not_paid'"/>
            </field>
        </field>
    </record>

    <!-- The third-party checks list inherits the own one above: swap the
         state column for the third-party labels (No cobrado / Cobrado /
         Girado, the last in yellow). -->
    <record id="l10n_latam_check_ext_view_third_party_check_tree" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.third_party_check.list</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_third_party_check_tree"/>
        <field name="arch" type="xml">
            <field name="check_state_own" position="replace">
                <field name="check_state_third" optional="show" widget="badge"
                       decoration-success="check_state_third == 'paid'"
                       decoration-warning="check_state_third == 'transferred'"
                       decoration-danger="check_state_third == 'not_paid'"/>
                <field name="pos_order_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Third-party check form: the POS orders the customer paid with it
         (whatever the check's state: Cobrado, No cobrado or Girado). The
         purchase orders it then paid once "Girado" are added by
         odossey_purchase_pos_payment_check. -->
    <record id="l10n_latam_check_ext_view_form_pos_orders" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.view.form.pos_orders</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook name="check_orders">
                    <page string="Órdenes POS pagadas" name="pos_orders" invisible="check_kind != 'third_party'">
                        <field name="pos_payment_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="pos_order_id"/>
                                <field name="payment_date"/>
                                <field name="payment_method_id"/>
                                <field name="amount"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="pos_paid_amount"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Payment form — new_checks inline list: add check_type + issue_date -->
    <record id="l10n_latam_check_ext_view_payment_form" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <list name="new_checks">
                <field name="name" position="after">
                    <field name="check_type"/>
                    <field name="issue_date"/>
                </field>
            </list>
            <list name="existing_checks">
                <field name="name" position="after">
                    <field name="check_type" optional="hide"/>
                    <field name="issue_date" optional="hide"/>
                </field>
            </list>
        </field>
    </record>


    <!-- Payment Register wizard (botón "Pagar" de facturas): new_checks + existing_checks -->
    <record id="l10n_latam_check_ext_view_payment_register" model="ir.ui.view">
        <field name="name">l10n_latam_check_ext.account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- new_checks list has no name attribute in the wizard, use xpath -->
            <xpath expr="//field[@name='l10n_latam_new_check_ids']//field[@name='name']" position="after">
                <field name="check_type"/>
                <field name="issue_date"/>
            </xpath>
            <list name="existing_checks">
                <field name="name" position="after">
                    <field name="check_type" optional="hide"/>
                    <field name="issue_date" optional="hide"/>
                </field>
            </list>
        </field>
    </record>

</odoo>
