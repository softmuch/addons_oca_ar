<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Cron diario: actualiza cotización USD/ARS desde divisas del Banco Nación Argentina.
        Se ejecuta 1 vez por día a las 08:00 (hora del servidor).
        Solo actualiza empresas con moneda base ARS.
    -->
    <record id="ir_cron_bna_rate_update" model="ir.cron">
        <field name="name">(l10n_ar) Actualizar cotización USD/ARS - Banco Nación</field>
        <field name="model_id" ref="base.model_res_currency" />
        <field name="state">code</field>
        <field name="code">model._bna_update_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>
</odoo>
